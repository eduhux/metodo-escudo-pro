# ==========================================================================
# MÉTODO ESCUDO PRO — Variáveis de ambiente
# Copie este arquivo para ".env.local" e preencha com suas chaves reais.
# ==========================================================================

# --- MODO MOCK ---------------------------------------------------------------
# "true"  = roda a plataforma com dados fake, sem precisar de Firebase/Panda.
# "false" = usa Firebase real (produção).
NEXT_PUBLIC_MOCK_MODE=true

# --- FIREBASE (client SDK) ---------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- FIREBASE ADMIN (server SDK — usado no webhook) --------------------------
# Cole o JSON da service account em uma linha (ou use as 3 variáveis abaixo).
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# A private key deve manter os \n. Envolva em aspas.
FIREBASE_PRIVATE_KEY=""

# --- KIWIFY ------------------------------------------------------------------
# Token/segredo usado para validar a assinatura do webhook.
KIWIFY_WEBHOOK_TOKEN=

# --- PANDA VIDEO -------------------------------------------------------------
# Subdomínio do seu player (ex.: player-vz-xxxx). Aparece na URL do embed.
NEXT_PUBLIC_PANDA_PLAYER_SUBDOMAIN=

# --- LINKS -------------------------------------------------------------------
# URL do checkout da Kiwify (botão "Comprar Agora").
NEXT_PUBLIC_KIWIFY_CHECKOUT_URL=https://pay.kiwify.com.br/seu-checkout

# URL pública do site (usada nos e-mails de definição de senha).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- E-MAIL (opcional — provider de envio) -----------------------------------
# Se usar Resend para os e-mails transacionais.
RESEND_API_KEY=
EMAIL_FROM="Método Escudo PRO <no-reply@seudominio.com.br>"
